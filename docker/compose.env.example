# Copy to docker/compose.env and pass it explicitly:
#   docker compose --env-file docker/compose.env up -d --build
# No secrets belong here. docker/compose.env is git-ignored.

# demo = no AI, works fully inside containers. live = Antigravity CLI; NOT supported inside these images yet
# (see docs/docker.md, "AI runtime"). Use the hybrid option documented there for live AI.
JONATHON_DOCKER_MODE=demo

# First start ONLY, for a brand-new installation: allow init to create an empty data directory. Set back to false after.
JONATHON_INIT_NEW_DATA_DIR=false

# ---- Data location ----
# Default (recommended on Windows and macOS): a Docker-managed volume named below. Move existing data in with the
# `restore` tool (docs/docker.md, "Moving data in and out").
JONATHON_DOCKER_DATA_MOUNT_TYPE=volume
JONATHON_DOCKER_VOLUME=jonathon-data
#
# Linux (native ext4/xfs disk), bind-mount a host folder instead. Absolute path; owned by JONATHON_DOCKER_UID:GID.
#   JONATHON_DOCKER_DATA_MOUNT_TYPE=bind
#   JONATHON_HOST_DATA_DIR=/home/you/.local/share/jonathon-docker
#   JONATHON_DOCKER_UID=1000
#   JONATHON_DOCKER_GID=1000
# Windows / macOS bind mounts (only after reading docs/docker.md "Storage"; never share one folder between the Docker
# stack and a running `pnpm dev` stack):
#   JONATHON_HOST_DATA_DIR=C:\Users\you\JonathonDocker            (Windows)
#   JONATHON_HOST_DATA_DIR=/Users/you/Library/Application Support/JonathonDocker   (macOS)

# ---- Optional read-only folder for "Import a folder" (appears as /imports in the app) ----
# JONATHON_HOST_IMPORT_DIR=C:\Clients\Acme
# JONATHON_HOST_IMPORT_DIR=/Users/you/Clients/Acme
# JONATHON_HOST_IMPORT_DIR=/home/you/clients/acme

# ---- Backups folder on the host (backup writes here, restore reads it read-only) ----
# JONATHON_HOST_BACKUP_DIR=D:\JonathonBackups

# ---- Ports (published on 127.0.0.1 only) ----
JONATHON_DOCKER_UI_PORT=3005
JONATHON_DOCKER_MCP_PORT=4100

JONATHON_DOCKER_LOG_LEVEL=info
JONATHON_DOCKER_WORKER_CONCURRENCY=2
JONATHON_DOCKER_JOB_MAX_ATTEMPTS=3

# ---- Sign in with Google for Jonathon (replaces the username/password account) ----
# Create once in Google Cloud Console → APIs & Services → Credentials → Create credentials → OAuth client ID →
# "Web application", authorized redirect URI: http://localhost:3005/api/v1/auth/google/callback
# (OAuth consent screen: External, Testing, add your Google account as a test user; scopes openid + email.)
# With a client id set, Google is the only way to sign in, for the accounts listed below.
# This file is git-ignored; keep the secret out of version control.
JONATHON_GOOGLE_CLIENT_ID=
JONATHON_GOOGLE_CLIENT_SECRET=
# Path of the redirect URI you registered: /api/v1/auth/google/callback (default) or /oauth2callback.
JONATHON_GOOGLE_REDIRECT_PATH=
# Required with Google sign-in: the Google account(s) that may sign in (comma-separated).
JONATHON_GOOGLE_ALLOWED_EMAILS=
