# Copy to .env and adjust. Never commit .env. No secrets are required for Jonathon itself;
# Antigravity CLI keeps its own sign-in in your user profile.

# live (Antigravity CLI) or demo (no AI; extractive, clearly labelled)
JONATHON_MODE=live

# Data root for client material and the database. MUST be outside this repository.
# Default when unset: %LOCALAPPDATA%\Jonathon (Windows) or ~/.local/share/jonathon
# JONATHON_DATA_DIR=

# Loopback only by default. Setting a non-loopback host also requires JONATHON_ALLOW_REMOTE=true (put TLS in front).
JONATHON_HOST=127.0.0.1
JONATHON_PORT=4100
JONATHON_WEB_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

JONATHON_SESSION_TTL_HOURS=12
JONATHON_MAX_UPLOAD_MB=50
# How long ask (UI/MCP) waits before returning a pending job_id
JONATHON_ASK_WAIT_MS=25000
JONATHON_WORKER_CONCURRENCY=2
JONATHON_PARSER_TIMEOUT_MS=60000
JONATHON_LOG_LEVEL=info

# Antigravity CLI
AGY_PATH=agy
# Optional: pin a model from `agy models`, and reasoning effort
# AGY_MODEL=gemini-3.8-flash-medium
# AGY_EFFORT=medium
# Draft extraction effort (default low; "default" = CLI default). Higher effort was very slow in live tests.
AGY_EXTRACTION_EFFORT=low
AGY_TIMEOUT_MS=240000
AGY_MAX_OUTPUT_BYTES=4194304
AGY_MAX_PROMPT_CHARS=200000

# Retrieval and context bounds
JONATHON_CONTEXT_CHUNKS=16
JONATHON_CONTEXT_MAX_CHARS=60000
JONATHON_HISTORY_TURNS=6
JONATHON_RETRIEVAL_ITERATIONS=2
JONATHON_REPAIR_ATTEMPTS=1
